{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "buildCommand": null,
  "functions": {
    "api/index.mjs": { "includeFiles": "data/**", "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://apod.nasa.gov https://*.nasa.gov; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
